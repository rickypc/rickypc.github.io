{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "paths": {
      "@site/*": ["./*"],
      "@theme/*": ["./src/theme/*"],
      "#buddhism/*": ["./docs/buddhism/*"],
      "#root/*": ["./*"]
    },
    "skipLibCheck": true,
    "strict": true
  },
  "include": ["*.config.ts", "docs", "src", "tests"]
}
