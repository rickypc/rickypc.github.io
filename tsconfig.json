{
  "compilerOptions": {
    "allowJs": true,
    "baseUrl": ".",
    "checkJs": false,
    "ignoreDeprecations": "6.0",
    "noEmit": true,
    "paths": {
      "@site/*": ["./*"],
      "#buddhism/*": ["./docs/buddhism/*"],
      "#root/*": ["./*"]
    },
    "strict": true
  },
  "extends": "@docusaurus/tsconfig",
  "include": ["*.config.ts", "docs", "__mocks__", "src", "tests"]
}
