  "overrides": {
    "ajv": "6.15.0",
    "ajv-keywords": "3.5.2",
    "baseline-browser-mapping": "*",
    "magic-string": "0.30.21",
    "schema-utils": "3.3.0",
    "sharp": "0.35.4",
    "third-party-web": "*"
  },
  "private": true,
  "scripts": {
    "build": "docusaurus build",
    "build:media": "docusaurus build:media",
    "clear": "docusaurus clear",
    "deploy": "docusaurus deploy",
    "docusaurus": "docusaurus",
    "prestart": "npm run build:media",
    "serve": "docusaurus serve --no-open",
    "start": "docusaurus start --no-open",
    "swizzle": "docusaurus swizzle",
    "test": "npm run test:deps:ci && npm run test:lint && npm run test:type && npm run test:unit",
    "test:biome": "biome check .",
    "test:deps:ci": "npm outdated --json | jq -r 'to_entries[] | [.key, .value.current, .value.wanted, .value.latest] | @tsv' | sed 's/\t/ | /g'",
    "test:e2e": "playwright test",
    "test:e2e:ci": "CI=true playwright test",
    "test:eslint": "eslint .",
    "test:lint": "npm run test:biome && npm run test:eslint",
    "test:type": "tsc",
    "test:unit": "bun test --coverage --parallel ./tests/unit",
    "test:unit:ci": "CI=true bun test --parallel --reporter=dots ./tests/unit",
    "write-heading-ids": "docusaurus write-heading-ids",
    "write-translations": "docusaurus write-translations"
  },
  "version": "0.0.0"
}
